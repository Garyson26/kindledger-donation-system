MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/dbname

# Must be at least 32 characters of high entropy (generate with: openssl rand -hex 32)
JWT_SECRET=<32-byte-hex>

# Key required to create admin accounts via the API
ADMIN_CREATION_KEY=<random-32-byte-hex>

# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=https://donation.foroceanfoundation.com,https://www.foroceanfoundation.com

# PayU integration
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_BASE_URL=https://test.payu.in

# PayU callback URLs (set these to your backend URL + /api/payment/...)
SUCCESS_URL=https://your-backend.vercel.app/api/payment/success
FAILURE_URL=https://your-backend.vercel.app/api/payment/failure
CANCEL_URL=https://your-backend.vercel.app/api/payment/cancel
NOTIFY_URL=https://your-backend.vercel.app/api/payment/webhook

# Frontend redirect URLs after PayU response
FRONTEND_SUCCESS_URL=https://donation.foroceanfoundation.com/payment/success
FRONTEND_FAILURE_URL=https://donation.foroceanfoundation.com/payment/failure

# Email (Gmail or SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
