# =============================================================================
# KindLedger Donation System - container stack configuration
# =============================================================================
#   cp .env.example .env    then fill in every value marked REQUIRED.
#
# This file configures the docker compose stack at the repository root.
# Backend/.env.example still describes the legacy Vercel serverless deployment
# and is superseded by this file; it is left in place until the Phase 3 cutover
# so the current production deployment stays documented.
#
# MONGODB_URI IS GONE. The datastore is MySQL. Note that Backend/config/db.js
# still requires it and calls process.exit(1) without it, which is why the api
# service is profile-gated in docker-compose.yml until Phase 3.
#
# Never commit the resulting .env. It is covered by Backend/.gitignore's
# `.env` rule only for that directory - the root .env is covered by the rule
# added in .gitignore alongside this file.
# =============================================================================

# -----------------------------------------------------------------------------
# MySQL  (REQUIRED)
# -----------------------------------------------------------------------------
# MySQL 8.0.16 OR LATER. MARIADB IS NOT SUPPORTED.
#
# 8.0.16 is where MySQL began ENFORCING CHECK constraints. Below it the
# constraints in db/schema.sql parse and are then silently ignored, so the
# schema applies with none of its integrity guarantees - a category could be
# priced at zero and a donation recorded for zero rupees.
#
# MariaDB has no utf8mb4_0900_* collations. The email uniqueness guarantee
# depends on utf8mb4_0900_as_ci, and a silent fallback to another collation
# either merges distinct donor accounts or permits duplicate ones.
#
# Both are enforced: npm run db:migrate and npm run db:seed refuse to proceed
# on an unsupported server. docker-compose.yml pins a correct mysql:8.4.
# -----------------------------------------------------------------------------
# Generate both with: openssl rand -base64 24
#
# Keep these ASCII and alphanumeric. Both values are also embedded in
# DATABASE_URL below, where reserved characters (@ : / ? # [ ] %) must be
# percent-encoded - the simplest way to avoid that trap is not to use them.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=kindledger
MYSQL_USER=kindledger
MYSQL_PASSWORD=

# The connection string Prisma and the application use. The host `db` is the
# compose service name, resolved on the internal network.
# Must match MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE above.
DATABASE_URL=mysql://kindledger:CHANGEME@db:3306/kindledger

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Rate limit store (SEC-04). No password: the instance is not reachable outside
# the compose network. If you expose it, set one and add it to the URL.
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Application  (REQUIRED)
# -----------------------------------------------------------------------------
NODE_ENV=production

# Must be at least 32 characters or the app throws at boot.
#   openssl rand -hex 32
JWT_SECRET=

# Required before any admin account can be self-registered. Without it, a
# signup requesting role=admin is refused outright (fails closed).
#   openssl rand -hex 32
ADMIN_CREATION_KEY=

# Comma-separated frontend origins, no trailing slash. The frontend stays on
# Vercel, so this is its deployed URL plus any custom domain.
ALLOWED_ORIGINS=https://donation.example.org,https://www.example.org

# -----------------------------------------------------------------------------
# Nginx
# -----------------------------------------------------------------------------
# Host ports. TLS is off until certificates are installed in
# docker/nginx/certs - see the warning at the top of docker/nginx/nginx.conf.
HTTP_PORT=80
HTTPS_PORT=443

# -----------------------------------------------------------------------------
# PayU  (REQUIRED - unchanged from the serverless deployment)
# -----------------------------------------------------------------------------
# The salt is the response-hash secret. Treat it as a payment credential: it is
# the only thing preventing a forged "payment succeeded" callback.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=

# https://test.payu.in for test credentials, https://secure.payu.in for live.
# Test keys do not work against the live host or vice versa.
PAYU_BASE_URL=https://test.payu.in

# Backend callback URLs handed to PayU. These now point at your own host
# through Nginx, not at a Vercel function.
SUCCESS_URL=https://api.example.org/api/payment/success
FAILURE_URL=https://api.example.org/api/payment/failure
CANCEL_URL=https://api.example.org/api/payment/cancel
NOTIFY_URL=https://api.example.org/api/payment/webhook

# Where the backend redirects the donor afterwards. These MUST match a real
# route in the frontend SPA - the currently deployed values do not, which is
# BUG-05 in the project documentation.
FRONTEND_SUCCESS_URL=https://donation.example.org/payment-success
FRONTEND_FAILURE_URL=https://donation.example.org/payment-failure

# -----------------------------------------------------------------------------
# Email  (REQUIRED - unchanged from the serverless deployment)
# -----------------------------------------------------------------------------
# Set EMAIL_SERVICE=gmail to use the Gmail transport (requires an App
# Password, not the account password). Leave it empty for generic SMTP and set
# the SMTP_* values instead.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
# Path inside the api container. Backed by the `uploads` named volume and
# served read-only by Nginx at /uploads/. Phase 5 owns the write path.
UPLOADS_DIR=/var/lib/kindledger/uploads
